{
  "name": "mira-cover",
  "private": true,
  "version": "1.0.0",
  "description": "Mira Cover Creator — standalone app",
  "author": "P.H. Lobato",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5174 && electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "dist:win": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.21",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.mirawriting.cover",
    "productName": "Mira Cover",
    "directories": {
      "output": "builds/Mira Cover"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "portable": {
      "artifactName": "Mira Cover.exe"
    }
  }
}
